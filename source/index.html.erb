---
title:
---

<% content_for :skip_main_id, "true" %>

<div class="index-page">
  <section class="posts-list" id="main">
    <% if defined?(prev_page) && prev_page %>
        <div class="container container-xs">
          <h3 class="posts-page-heading">
            Posts &ndash; page <%= page_number %>
          </h3>
        </div>
      </h3>
    <% else %>
      <div class="posts-heading markdown">
        <div class="container container-xs">
          <p class="mb0">
            Hi, thanks for stopping by 👋. I'm Stephen, an Austin-based
            software engineer, working at <a href="https://stripe.com">Stripe</a>.
          </p>
        </div>
      </div>
    <% end %>

    <%= partial 'partials/posts_listing' %>
  </section>
</div>
